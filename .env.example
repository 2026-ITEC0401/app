# 백엔드 API 주소 (웹 원본 .env 의 VITE_API_BASE_URL 과 같은 서버)
# EXPO_PUBLIC_ 접두사가 있어야 JS 번들에 포함되어 앱 코드에서 읽을 수 있다.
# 값을 바꾼 뒤에는 Metro 캐시 때문에 `npx expo start -c` 로 재시작해야 반영된다.
EXPO_PUBLIC_API_BASE_URL=https://13.233.91.248/v2

# 실시간 알림 WebSocket 주소 (명세 §9). 같은 서버의 wss 엔드포인트.
EXPO_PUBLIC_WS_BASE_URL=wss://13.233.91.248/v2
